{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "types": ["node"],
    "isolatedModules": true,
    "noEmitOnError": true
  },
  "include": [
    "**/*.ts",
    "../src/lib/migrations/**/*.ts",
    "../src/lib/schemas.ts"
  ],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "../src/lib/migrations/**/*.test.ts"]
}
